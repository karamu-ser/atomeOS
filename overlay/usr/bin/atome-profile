#!/usr/bin/env bash
set -euo pipefail

profile="${1:-}"

usage() {
    cat <<'EOF'
Usage:
  sudo atome-profile pro         (ou strong: developpement intensif, monitoring & IA forte)
  sudo atome-profile developer   (git, dev tools, docker, snap code)
  sudo atome-profile lightweight (outils legers du quotidien)
  sudo atome-profile student     (bureautique, documents, etudes)
  sudo atome-profile creator     (creation graphique, video, audio)
EOF
}

install_packages() {
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
}

case "$profile" in
    ""|-h|--help|help)
        usage
        exit 0
        ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    echo "Lancez cette commande avec sudo."
    exit 1
fi

case "$profile" in
    lightweight)
        install_packages htop btop fastfetch curl wget
        ;;
    student)
        install_packages libreoffice evince gnome-calendar thunderbird
        ;;
    creator)
        install_packages gimp inkscape kdenlive audacity vlc
        ;;
    developer)
        install_packages git vim nano zsh fzf tmux ripgrep fd-find bat eza build-essential cmake pkg-config python3 python3-pip python3-venv nodejs npm docker.io
        if command -v snap >/dev/null 2>&1; then
            snap install code --classic || echo "VS Code n'a pas pu etre installe maintenant. Verifiez la connexion puis relancez sudo atome-profile developer."
        else
            echo "Snap est absent: installation automatique de VS Code ignoree."
        fi
        systemctl enable docker >/dev/null 2>&1 || true
        ;;
    pro|strong)
        install_packages git vim nano zsh fzf tmux ripgrep fd-find bat eza build-essential cmake pkg-config python3 python3-pip python3-venv nodejs npm docker.io htop btop iotop sysstat nvtop
        if command -v snap >/dev/null 2>&1; then
            snap install code --classic || echo "VS Code n'a pas pu etre installe maintenant. Verifiez la connexion puis relancez sudo atome-profile pro."
        else
            echo "Snap est absent: installation automatique de VS Code ignoree."
        fi
        systemctl enable docker >/dev/null 2>&1 || true

        # If Ollama is present, pull the optimal strong model
        if command -v atome-ai >/dev/null 2>&1 && command -v ollama >/dev/null 2>&1; then
            echo "[+] Profil Pro / Strong: Verification du modele IA..."
            rec_model="$(atome-ai hardware 2>/dev/null | awk '/Tier recommande/ {print $NF}' || echo "")"
            if [ -n "$rec_model" ]; then
                echo "[+] Telechargement du modele recommande : $rec_model"
                ollama pull "$rec_model" || true
            fi
        fi
        ;;
    *)
        echo "Profil inconnu: $profile"
        usage
        exit 1
        ;;
esac

echo "Profil Atome applique: $profile"

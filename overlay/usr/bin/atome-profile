#!/usr/bin/env bash
set -euo pipefail

profile="${1:-}"

usage() {
    cat <<'EOF'
Usage:
  sudo atome-profile lightweight
  sudo atome-profile student
  sudo atome-profile creator
  sudo atome-profile developer
EOF
}

install_packages() {
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
}

case "$profile" in
    ""|-h|--help|help)
        usage
        exit 0
        ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    echo "Lancez cette commande avec sudo."
    exit 1
fi

case "$profile" in
    lightweight)
        install_packages htop btop fastfetch curl wget
        ;;
    student)
        install_packages libreoffice evince gnome-calendar thunderbird
        ;;
    creator)
        install_packages gimp inkscape kdenlive audacity vlc
        ;;
    developer)
        install_packages git vim nano zsh fzf tmux ripgrep fd-find bat eza build-essential cmake pkg-config python3 python3-pip python3-venv nodejs npm docker.io
        if command -v snap >/dev/null 2>&1; then
            snap install code --classic || echo "VS Code n'a pas pu etre installe maintenant. Verifiez la connexion puis relancez sudo atome-profile developer."
        else
            echo "Snap est absent: installation automatique de VS Code ignoree."
        fi
        systemctl enable docker >/dev/null 2>&1 || true
        ;;
    *)
        echo "Profil inconnu: $profile"
        usage
        exit 1
        ;;
esac

echo "Profil Atome applique: $profile"
